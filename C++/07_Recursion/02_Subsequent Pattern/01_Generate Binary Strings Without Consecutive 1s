class Solution
{
public:
    vector<string> generateBinaryStrings(int n)
    {
        vector<string> v;
        string s;
        binary(v, s, n);
        return v;
    }

    void binary(vector<string> &v, string &s, int n)
    {
        if (s.size() == n)
        {
            v.push_back(s);
            return;
        }

        s.push_back('0');
        binary(v, s, n);
        s.pop_back();

        if (s.size() != 0 && s.back() != '1')
        {
            s.push_back('1');
            binary(v, s, n);
            s.pop_back();
        }
    }
};